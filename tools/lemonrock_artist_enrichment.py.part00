#!/usr/bin/env python3
"""Founder-authorised Lemonrock artist profile enrichment for the bndy POC.

Enumerates GB artists with current gigs, reads each artist's Lemonrock profile,
and adds profile-level genres plus verified Facebook URLs. Facebook URLs are
accepted only when directly present on the Lemonrock profile, or discovered on
an official website linked from that exact Lemonrock profile.
"""
from __future__ import annotations

import concurrent.futures
import json
import os
import re
import sys
import time
import traceback
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable
from urllib.parse import parse_qs, unquote, urljoin, urlparse, urlunparse

import requests
from bs4 import BeautifulSoup
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

BASE_URL = "https://www.lemonrock.com"
LETTERS = tuple("ABCDEFGHIJKLMNOPQRSTUVWXYZ") + ("123",)
OUT = Path(os.environ.get("OUTPUT_DIR", "lemonrock_artist_enrichment"))
DELAY = float(os.environ.get("LEMONROCK_DELAY", "0.2"))
SITE_WORKERS = int(os.environ.get("OFFICIAL_SITE_WORKERS", "8"))
USER_AGENT = os.environ.get(
    "LEMONROCK_USER_AGENT",
    "bndy-lemonrock-authorised-artist-enrichment/1.0 (+founder-approved POC)",
)

GIG_COUNT_RE = re.compile(r"\b(\d+)\s+gigs?\b", re.I)
ACT_TYPE_RE = re.compile(r"\b(Solo Artist|Duo|Trio|\d+\s+piece)\b", re.I)
BASED_RE = re.compile(r"\bbased\s*:\s*(.+)$", re.I)
FACEBOOK_TEXT_RE = re.compile(
    r"(?:(?:https?://)?(?:www\.)?(?:facebook\.com|fb\.com|fb\.me)/[^\s<>'\"\]\[(){}]+)", re.I
)
FIELD_PATTERNS = {
    "band_formats": re.compile(r"Band formats?\s+(.*?)\s+Genres\s+", re.I | re.S),
    "genres_raw": re.compile(r"Genres\s+(.*?)\s+Originals/Covers\s+", re.I | re.S),
    "originals_covers": re.compile(r"Originals/Covers\s+(.*?)(?:\s+Minimum fee\s+|\s+Based in\s+|\s+Tel\s+|\s+Web\s+|\s+Email\s+|\s+Send Enquiry\s+|\s+Info\s+|\s+Page Info\s+)", re.I | re.S),
    "minimum_fee": re.compile(r"Minimum fee\s+(.*?)(?:\s+Based in\s+|\s+Tel\s+|\s+Web\s+|\s+Email\s+|\s+Send Enquiry\s+|\s+Info\s+|\s+Page Info\s+)", re.I | re.S),
    "based_in": re.compile(r"Based in\s+(.*?)(?:\s+Tel\s+|\s+Web\s+|\s+Email\s+|\s+Send Enquiry\s+|\s+Info\s+|\s+Page Info\s+)", re.I | re.S),
}
EXCLUDED_PATHS = {
    "", "guide", "join", "about", "install", "help", "terms", "editor",
    "bands", "venues", "towns", "favourites", "login", "logout", "account",
    "allbands", "allvenues", "available-bands", "newestgigs", "statistics",
}
SOCIAL_OR_MEDIA_HOSTS = {
    "facebook.com", "www.facebook.com", "m.facebook.com", "mbasic.facebook.com",
    "instagram.com", "www.instagram.com", "youtube.com", "www.youtube.com", "youtu.be",
    "twitter.com", "www.twitter.com", "x.com", "www.x.com", "tiktok.com", "www.tiktok.com",
    "soundcloud.com", "www.soundcloud.com", "spotify.com", "open.spotify.com",
}
FACEBOOK_REJECT_SEGMENTS = {
    "share", "sharer", "sharer.php", "share.php", "dialog", "plugins", "login",
    "groups", "events", "watch", "reel", "reels", "photo", "photos", "posts",
    "permalink.php", "story.php", "marketplace", "gaming", "help", "privacy",
}
LIKELY_INTERNAL_RE = re.compile(r"(?:contact|about|links|social|follow|connect)", re.I)


@dataclass(frozen=True)
class ArtistRef:
    slug: str
    name: str
    index_genre: str | None
    act_type: str | None
    based_area: str | None
    listed_current_gig_count: int | None
    metadata_text: str
    source_url: str
    index_letter: str


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def clean_space(value: str | None) -> str | None:
    cleaned = re.sub(r"\s+", " ", value or "").strip(" \t\r\n|,")
    return cleaned or None


def build_session() -> requests.Session:
    session = requests.Session()
    retry = Retry(
        total=4, connect=4, read=4, status=4, backoff_factor=0.8,
        status_forcelist=(408, 429, 500, 502, 503, 504),
        allowed_methods=frozenset({"GET"}), respect_retry_after_header=True,
    )
    session.mount("https://", HTTPAdapter(max_retries=retry, pool_connections=12, pool_maxsize=12))
    session.mount("http://", HTTPAdapter(max_retries=retry, pool_connections=12, pool_maxsize=12))
    session.headers.update({
        "User-Agent": USER_AGENT,
        "Accept": "text/html,application/xhtml+xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-GB,en;q=0.9",
    })
    return session


def get(session: requests.Session, url: str, timeout: int = 35) -> requests.Response:
    response = session.get(url, timeout=timeout, allow_redirects=True)
    response.raise_for_status()
    return response


def local_row_text(anchor) -> str:
    candidates: list[str] = []
    node = anchor
    for _ in range(5):
        node = getattr(node, "parent", None)
        if node is None:
            break
        text = node.get_text(" ", strip=True)
        if text:
            candidates.append(text)
            if GIG_COUNT_RE.search(text) and len(text) <= 600:
                return text
    return candidates[0] if candidates else anchor.get_text(" ", strip=True)


def parse_artist_anchor(anchor, letter: str) -> ArtistRef | None:
    href = (anchor.get("href") or "").strip()
    name = clean_space(anchor.get_text(" ", strip=True))
    if not href or not name:
        return None
    absolute = urljoin(BASE_URL + "/", href)
    parsed = urlparse(absolute)
    path = parsed.path.strip("/")
    if (
        parsed.netloc.casefold() not in {"lemonrock.com", "www.lemonrock.com"}
        or not path or "/" in path or "." in path or parsed.query
        or path.casefold() in EXCLUDED_PATHS
    ):
        return None
    text = local_row_text(anchor)
    if not GIG_COUNT_RE.search(text):
        return None
    metadata = text[len(name):].strip() if text.startswith(name) else text
    left, right = metadata.find("("), metadata.rfind(")")
    if left >= 0 and right > left:
        metadata = metadata[left + 1:right]
    metadata = clean_space(metadata) or ""
    count_match = GIG_COUNT_RE.search(metadata)
    act_match = ACT_TYPE_RE.search(metadata)
    based_match = BASED_RE.search(metadata)
